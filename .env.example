# ==============================================================================
# ProcessIQ Configuration Template
# ==============================================================================

# Backend Configuration
# ---------------------
# SQLite for local & Render production (relative file path)
DATABASE_URL=sqlite:///./processiq.db

# JWT Authentication
# In production on Render, generate a strong random key or use Render's generateValue
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Supported providers: local, openai, gemini, anthropic
# Default 'local' runs 100% locally with zero external API dependencies or costs.
LLM_PROVIDER=local
LLM_MODEL=local-heuristic-v1
LLM_TEMPERATURE=0.1

# Optional external LLM API keys (Leave blank to use Local Fallback)
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# CORS Allowed Origins
# Comma-separated or JSON list of allowed origins.
# Render automatically allows https://*.onrender.com
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Configuration
# ----------------------
# For production build on Render, set this to your deployed backend URL.
# If omitted during local dev, defaults to http://127.0.0.1:8000
VITE_API_URL=https://your-processiq-backend.onrender.com
